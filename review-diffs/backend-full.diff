+def _ensure_pre_restore_backup(*, shop: Shop, restore_backup: BackupHistory, user=None):
+    """
+    Keep a safety copy of the current tenant state before overwriting master data.
+    The selected restore backup does not count as that safety copy.
+    """
+    completed_at = restore_backup.completed_at or restore_backup.started_at
+    existing = BackupHistory.objects.filter(
+        shop=shop,
+        status=BackupHistory.Status.SUCCESS,
+        deleted_at__isnull=True,
+    ).exclude(pk=restore_backup.pk)
+
+    if completed_at:
+        existing = existing.filter(completed_at__gte=completed_at)
+
+    if existing.exists():
+        return None
+
+    from pos.services.backup_service import run_manual_backup
+
+    return run_manual_backup(
+        shop=shop,
+        user=user,
+        include_media=False,
+        include_users=False,
+        include_settings=True,
+    )
+
