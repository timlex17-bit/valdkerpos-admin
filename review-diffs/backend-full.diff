+def _preserve_fields(model, obj, row: dict, field_names):
+    values = {
+        field_name: row.get(field_name)
+        for field_name in field_names
+        if field_name in row and row.get(field_name) not in (None, "")
+    }
+    if values:
+        model.objects.filter(pk=obj.pk).update(**values)
+        for field_name, value in values.items():
+            setattr(obj, field_name, value)
+
+
+def _upsert_simple_model(model, shop: Shop, rows, field_names):
+    id_map = {}
+    restored_ids = []
+
+    for row in rows:
+        old_id = _row_id(row)
+        obj = _instance_from_backup_id(model, shop, old_id)
+        if obj is None:
+            obj = _build_new_instance(model, shop, old_id)
+
+        for field_name in field_names:
+            setattr(obj, field_name, row.get(field_name))
+
+        obj.shop = shop
+        obj.save()
+
+        if old_id is not None:
+            id_map[old_id] = obj
+        restored_ids.append(obj.id)
+
+    return id_map, restored_ids
+
+
+def _existing_user_map(shop: Shop):
+    return {
+        user.id: user
+        for user in CustomUser.objects.filter(shop=shop)
+    }
+
+
+def _optional_user_id(row: dict, field_name: str, user_map: dict[int, CustomUser]):
+    old_id = _coerce_id(row.get(field_name))
+    if old_id is None:
+        return None
+    user = user_map.get(old_id)
+    return user.id if user else None
+
+
+def _required_user_id(row: dict, field_name: str, user_map: dict[int, CustomUser], section: str):
+    old_id = _coerce_id(row.get(field_name))
+    if old_id is None:
+        raise ValueError(f"Missing required FK {section}.{field_name}.")
+    user = user_map.get(old_id)
+    if not user:
+        raise ValueError(f"Missing tenant user for {section}.{field_name}={old_id}.")
+    return user.id
+
+
+def _mapped_obj(id_map: dict, old_id, label: str, *, required: bool = False):
+    old_id = _coerce_id(old_id)
+    if old_id is None:
+        if required:
+            raise ValueError(f"Missing required FK target for {label}.")
+        return None
+    obj = id_map.get(old_id)
+    if obj is None and required:
+        raise ValueError(f"Missing FK target for {label}={old_id}.")
+    return obj
+
+
+def _existing_child_from_backup_id(model, old_id, shop: Shop, shop_getter):
+    old_id = _coerce_id(old_id)
+    if old_id is None:
+        return None
+    existing = model.objects.filter(pk=old_id).first()
+    if existing is None:
+        return None
+    if int(shop_getter(existing)) != int(shop.id):
+        raise ValueError(f"Backup {model.__name__} id {old_id} belongs to a different shop.")
+    return existing
+
+
+def _build_child_instance(model, old_id):
+    old_id = _coerce_id(old_id)
+    if old_id is not None and not model.objects.filter(pk=old_id).exists():
+        return model(id=old_id)
+    return model()
+
