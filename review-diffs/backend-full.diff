+def _safe_media_basename(value: str, fallback: str = "restored_file") -> str:
+    name = os.path.basename(str(value or "").replace("\\", "/")).strip()
+    if not name:
+        name = fallback
+    safe = "".join(ch if ch.isalnum() or ch in {".", "_", "-"} else "_" for ch in name)
+    return safe.strip("._") or fallback
+
+
+def _media_zip_entries(metadata: dict):
+    media_export = metadata.get("media_export") or {}
+    mapping = media_export.get("media_mapping")
+    if mapping is None:
+        mapping = media_export.get("exported_files") or []
+    return mapping if isinstance(mapping, list) else []
+
+
+def _file_field_names_for_obj(obj):
+    return {
+        field.name
+        for field in obj._meta.get_fields()
+        if isinstance(field, FileField)
+    }
+
+
+def _restore_media_files(*, shop: Shop, backup: BackupHistory | None, package: dict, object_maps: dict) -> dict:
+    metadata = package.get("metadata") or {}
+    entries = _media_zip_entries(metadata)
+    warnings = []
+    restored = []
+
+    if not entries:
+        return {"restored": restored, "warnings": warnings}
+
+    if not backup:
+        warnings.append("Media restore skipped because backup history is unavailable.")
+        return {"restored": restored, "warnings": warnings}
+
+    try:
+        backup_path = validate_backup_history_for_restore(backup)
+    except ValueError as exc:
+        warnings.append(f"Media restore skipped: {exc}")
+        return {"restored": restored, "warnings": warnings}
+
+    try:
+        with zipfile.ZipFile(backup_path, "r") as zf:
+            zip_names = set(zf.namelist())
+            for index, entry in enumerate(entries):
+                if not isinstance(entry, dict):
+                    warnings.append(f"Media mapping row {index + 1} is invalid.")
+                    continue
+
+                model_label = _safe_str(entry.get("model")).lower()
+                old_object_id = _coerce_id(entry.get("old_object_id", entry.get("object_id")))
+                field_name = _safe_str(entry.get("field_name", entry.get("field")))
+                zip_path = _safe_str(entry.get("zip_path"))
+
+                if not model_label or old_object_id is None or not field_name or not zip_path:
+                    warnings.append(f"Media mapping row {index + 1} is incomplete.")
+                    continue
+
+                if zip_path not in zip_names:
+                    warnings.append(
+                        f"Media file missing in ZIP: {model_label}.{field_name} object {old_object_id} ({zip_path})."
+                    )
+                    continue
+
+                target = (object_maps.get(model_label) or {}).get(old_object_id)
+                if target is None:
+                    warnings.append(
+                        f"Media target not found for {model_label}.{field_name} object {old_object_id}."
+                    )
+                    continue
+
+                if model_label != "shop" and getattr(target, "shop_id", shop.id) != shop.id:
+                    warnings.append(
+                        f"Media target skipped because it belongs to another shop: {model_label}.{field_name} object {old_object_id}."
+                    )
+                    continue
+
+                if model_label == "shop" and target.id != shop.id:
+                    warnings.append("Shop media target does not match current shop.")
+                    continue
+
+                if field_name not in _file_field_names_for_obj(target):
+                    warnings.append(
+                        f"Media field is not a file field: {model_label}.{field_name}."
+                    )
+                    continue
+
+                try:
+                    content = zf.read(zip_path)
+                    basename = _safe_media_basename(
+                        entry.get("file_name") or zip_path,
+                        f"{model_label}_{field_name}",
+                    )
+                    object_id = getattr(target, "pk", old_object_id)
+                    storage_name = (
+                        f"restored_media/{shop.code}/{model_label}/{object_id}/"
+                        f"{field_name}/{basename}"
+                    )
+
+                    field_file = getattr(target, field_name)
+                    field_file.save(storage_name, ContentFile(content), save=False)
+                    target.__class__.objects.filter(pk=target.pk).update(**{
+                        field_name: field_file.name
+                    })
+                    setattr(target, field_name, field_file.name)
+                    restored.append({
+                        "model": model_label,
+                        "object_id": object_id,
+                        "old_object_id": old_object_id,
+                        "field_name": field_name,
+                        "zip_path": zip_path,
+                        "stored_name": field_file.name,
+                    })
+                except Exception as exc:
+                    warnings.append(
+                        f"Media restore failed for {model_label}.{field_name} object {old_object_id}: {exc}"
+                    )
+    except zipfile.BadZipFile:
+        warnings.append("Media restore skipped because backup ZIP is invalid.")
+
+    return {"restored": restored, "warnings": warnings}
+
