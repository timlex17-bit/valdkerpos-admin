+def _add_error(errors, message):
+    if message not in errors:
+        errors.append(message)
+
+
+def _coerce_id(value):
+    if value in (None, ""):
+        return None
+    try:
+        return int(value)
+    except (TypeError, ValueError):
+        return None
+
+
+def _count_section(data: dict, section: str, errors: list[str]):
+    value = data.get(section)
+    if section == "backup_setting":
+        if value in (None, ""):
+            return 0
+        if not isinstance(value, dict):
+            _add_error(errors, "Backup section 'backup_setting' must be an object.")
+            return 0
+        return 1
+
+    if not isinstance(value, list):
+        _add_error(errors, f"Backup section '{section}' must be a list.")
+        return 0
+    return len(value)
+
+
+def _section_ids(data: dict, section: str, errors: list[str]):
+    rows = data.get(section) or []
+    if not isinstance(rows, list):
+        _add_error(errors, f"Backup section '{section}' must be a list.")
+        return set()
+
+    ids = set()
+    for index, row in enumerate(rows):
+        if not isinstance(row, dict):
+            _add_error(errors, f"Backup section '{section}' row {index + 1} must be an object.")
+            continue
+        row_id = _coerce_id(row.get("id"))
+        if row_id is None:
+            _add_error(errors, f"Backup section '{section}' row {index + 1} has invalid id.")
+            continue
+        ids.add(row_id)
+    return ids
+
+
+def _validate_fk(rows, *, section, field, target_section, target_ids, errors, required=False):
+    if not isinstance(rows, list):
+        return
+
+    for index, row in enumerate(rows):
+        if not isinstance(row, dict):
+            continue
+        value = row.get(field)
+        if value in (None, ""):
+            if required:
+                _add_error(
+                    errors,
+                    f"Missing required FK {section}.{field} at row {index + 1}.",
+                )
+            continue
+
+        fk_id = _coerce_id(value)
+        if fk_id is None:
+            _add_error(errors, f"Invalid FK {section}.{field}={value!r} at row {index + 1}.")
+            continue
+
+        if fk_id not in target_ids:
+            _add_error(
+                errors,
+                f"Missing FK target for {section}.{field}={fk_id} in section '{target_section}'.",
+            )
