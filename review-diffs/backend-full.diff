+def _instance_from_backup_id(model, shop: Shop, old_id):
+    if old_id is None:
+        return None
+
+    existing = model.objects.filter(pk=old_id).first()
+    if existing and existing.shop_id != shop.id:
+        raise ValueError(
+            f"Backup {model.__name__} id {old_id} belongs to a different shop."
+        )
+    return existing
