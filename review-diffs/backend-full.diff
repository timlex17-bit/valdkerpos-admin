+def _validate_media_mapping(metadata: dict, warnings: list[str]):
+    media_export = metadata.get("media_export") or {}
+    included = metadata.get("included") or {}
+
+    if not included.get("media"):
+        warnings.append("Media files were not included in this backup package.")
+        return
+
+    mapping = media_export.get("media_mapping")
+    if mapping is None:
+        mapping = media_export.get("exported_files") or []
+        warnings.append("Backup uses legacy media metadata; media_mapping is not explicit.")
+
+    if not isinstance(mapping, list):
+        warnings.append("Media mapping is not readable; media restore will be skipped.")
+        return
+
+    for index, item in enumerate(mapping):
+        if not isinstance(item, dict):
+            warnings.append(f"Media mapping row {index + 1} is invalid.")
+            continue
+        missing = [
+            field
+            for field in ("model", "zip_path")
+            if not item.get(field)
+        ]
+        object_id = item.get("old_object_id", item.get("object_id"))
+        field_name = item.get("field_name", item.get("field"))
+        if object_id in (None, ""):
+            missing.append("old_object_id")
+        if not field_name:
+            missing.append("field_name")
+        if missing:
+            warnings.append(
+                f"Media mapping row {index + 1} missing: {', '.join(missing)}."
+            )
+
+    skipped_count = int(media_export.get("skipped_count") or 0)
+    if skipped_count:
+        warnings.append(
+            f"{skipped_count} media file(s) were skipped during backup export."
+        )
