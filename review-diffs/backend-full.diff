+def adjust_warehouse_stock(
+    *,
+    shop,
+    product,
+    quantity_delta,
+    warehouse=None,
+    allow_create=True,
+    allow_negative=False,
+):
+    """
+    Atomically adjust one warehouse stock row and refresh Product.stock cache.
+    Returns (warehouse_stock, before_quantity, after_quantity).
+    """
+    if not shop:
+        raise ValidationError({"shop": "Shop is required."})
+    if not product:
+        raise ValidationError({"product": "Product is required."})
+    if product.shop_id != shop.id:
+        raise ValidationError({"product": "Product must belong to the same shop."})
+    if not product.track_stock:
+        before = int(product.stock or 0)
+        return None, before, before
+
+    delta = int(quantity_delta or 0)
+    warehouse = warehouse or get_or_create_default_warehouse(shop)
+
+    if warehouse.shop_id != shop.id:
+        raise ValidationError({"warehouse": "Warehouse must belong to the same shop."})
+
+    qs = WarehouseStock.objects.select_for_update()
+    if allow_create:
+        warehouse_stock, _ = qs.get_or_create(
+            shop=shop,
+            warehouse=warehouse,
+            product=product,
+            defaults={"quantity": 0, "min_stock": 0},
+        )
+    else:
+        try:
+            warehouse_stock = qs.get(shop=shop, warehouse=warehouse, product=product)
+        except WarehouseStock.DoesNotExist:
+            raise ValidationError({
+                "stock": (
+                    f"Stock row for '{product.name}' does not exist in warehouse "
+                    f"'{warehouse.name}'."
+                )
+            })
+
+    before = int(warehouse_stock.quantity or 0)
+    after = before + delta
+
+    if after < 0 and not allow_negative:
+        raise ValidationError({
+            "stock": (
+                f"Insufficient stock for '{product.name}' in warehouse "
+                f"'{warehouse.name}'. Remaining {before}, requested {abs(delta)}."
+            )
+        })
+
+    warehouse_stock.quantity = after
+    warehouse_stock.save(update_fields=["quantity", "updated_at"])
+    sync_product_total_stock(product.id)
+
+    return warehouse_stock, before, after
+
+
+def set_product_total_stock_via_default_warehouse(*, shop, product, new_total):
+    """
+    Set the product total cache target by applying the delta to the default
+    warehouse. Legacy endpoints without a warehouse selector use this path.
+    """
+    new_total = int(new_total or 0)
+    if new_total < 0:
+        raise ValidationError({"stock": "Stock cannot be negative."})
+
+    current_total = sync_product_total_stock(product.id)
+    delta = new_total - int(current_total or 0)
+    return adjust_warehouse_stock(
+        shop=shop,
+        product=product,
+        quantity_delta=delta,
+        warehouse=get_or_create_default_warehouse(shop),
+        allow_create=True,
+        allow_negative=False,
+    )
+
+
 
